APP_NAME=Guilin Tourism AI Assistant
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*

# P0 defaults to mock mode so the API can be tested without a provider.
LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

SESSION_MAX_MESSAGES=20
