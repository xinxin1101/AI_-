APP_NAME=Guilin Tourism AI Assistant
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*

LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

SESSION_MAX_MESSAGES=20

# P1 RAG
RAG_ENABLED=true
RAG_KNOWLEDGE_PATH=data/knowledge
RAG_CHUNK_SIZE_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
RAG_DENSE_TOP_K=8
RAG_BM25_TOP_K=8
RAG_FUSED_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
RAG_CITATION_SNIPPET_CHARS=180

# Deterministic offline fallback. Switch to openai_compatible for real embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256
EMBEDDING_TIMEOUT_SECONDS=60

# memory for local/CI; qdrant for deployment.
RAG_VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=guilin_tourism
QDRANT_TIMEOUT_SECONDS=30

# local is deterministic lexical reranking. http supports a BGE/Cohere-style /rerank endpoint.
RERANK_MODE=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker
RERANK_TIMEOUT_SECONDS=30
