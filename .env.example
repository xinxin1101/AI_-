APP_NAME=Guilin Tourism AI Assistant
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*

# LLM provider/model remains fully configurable. Never commit real API keys.
LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_FORCE_STREAM=false
LLM_MODALITIES=text
LLM_EXTRA_BODY_JSON={}
LLM_CAPTURE_STREAM_USAGE=false

# Future Qwen profile; model name can be replaced without code changes.
# LLM_MOCK_MODE=false
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your-key
# LLM_MODEL=qwen3.5-omni-flash
# LLM_FORCE_STREAM=true
# LLM_MODALITIES=text
# LLM_EXTRA_BODY_JSON={"enable_thinking":false}

# P3 short-term session state. Docker Compose overrides SESSION_BACKEND=redis.
SESSION_BACKEND=memory
SESSION_MAX_MESSAGES=20
SESSION_TTL_SECONDS=86400
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=guilin-ai
REDIS_SOCKET_TIMEOUT_SECONDS=3

# P3/P3.5 durable persistence. Production deployment should run `alembic upgrade head`.
PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql://guilin:guilin@localhost:5432/guilin_ai
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=10
DATABASE_AUTO_CREATE=false
METRICS_WINDOW_SIZE=1000

# P3.5 privacy and retention.
PII_REDACTION_ENABLED=true
TRACE_RETENTION_DAYS=30
MESSAGE_RETENTION_DAYS=30
FEEDBACK_RETENTION_DAYS=90
RETENTION_CLEANUP_ON_STARTUP=false

# P3.5 API security. Use strong random keys in production and never commit them.
API_AUTH_ENABLED=false
API_KEYS=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_URL=
SECURITY_BYPASS_PATHS=/,/health,/ready,/metrics,/docs,/redoc,/openapi.json

# P3.5 structured logs and OpenTelemetry.
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=guilin-tourism-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXCLUDED_URLS=/health,/ready,/metrics

RAG_ENABLED=true
RAG_KNOWLEDGE_PATH=data/knowledge/verified
RAG_CHUNK_SIZE_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
RAG_DENSE_TOP_K=8
RAG_BM25_TOP_K=8
RAG_FUSED_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
RAG_CITATION_SNIPPET_CHARS=180

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256
EMBEDDING_TIMEOUT_SECONDS=60

RAG_VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=guilin_tourism
QDRANT_TIMEOUT_SECONDS=30

RERANK_MODE=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker
RERANK_TIMEOUT_SECONDS=30

KNOWLEDGE_SOURCE_REGISTRY=data/sources/guilin_official_sources.json
KNOWLEDGE_SNAPSHOT_DIR=data/snapshots
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=30
RAG_EVAL_DATASET=eval/rag_eval.jsonl
RAG_EVAL_RECALL_AT_5_MIN=0.80
RAG_EVAL_MRR_MIN=0.70
RAG_EVAL_GROUNDING_ACCURACY_MIN=0.80
RAG_EVAL_CITATION_HIT_RATE_MIN=0.80

AGENT_ENABLED=true
TOOL_MOCK_MODE=true
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_TEXT_LENGTH=120
TOOL_RETRY_ATTEMPTS=2
TOOL_RETRY_BASE_DELAY_SECONDS=0.20
TOOL_RETRY_MAX_DELAY_SECONDS=2.0
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RECOVERY_SECONDS=30
TOOL_HTTP_USER_AGENT=guilin-tourism-ai/0.3.5

WEATHER_PROVIDER=open_meteo
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

SCENIC_PROVIDER=amap
ROUTE_PROVIDER=amap
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_REGION=桂林
AMAP_CITYCODE_DEFAULT=0773

AGENT_EVAL_DATASET=eval/intent_router_eval.jsonl
AGENT_EVAL_INTENT_ACCURACY_MIN=0.90
AGENT_EVAL_TOOL_SELECTION_ACCURACY_MIN=0.90
