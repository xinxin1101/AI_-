APP_NAME=Guilin Tourism AI Assistant
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=*

# LLM provider/model remains fully configurable. Never commit real API keys.
LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_FORCE_STREAM=false
LLM_MODALITIES=text
LLM_EXTRA_BODY_JSON={}

# Future Qwen profile; model name can be replaced without code changes.
# LLM_MOCK_MODE=false
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your-dashscope-key
# LLM_MODEL=qwen3.5-omni-flash
# LLM_FORCE_STREAM=true
# LLM_MODALITIES=text
# LLM_EXTRA_BODY_JSON={"enable_thinking":false}

SESSION_MAX_MESSAGES=20

RAG_ENABLED=true
RAG_KNOWLEDGE_PATH=data/knowledge/verified
RAG_CHUNK_SIZE_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=100
RAG_DENSE_TOP_K=8
RAG_BM25_TOP_K=8
RAG_FUSED_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=6000
RAG_CITATION_SNIPPET_CHARS=180

EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=256
EMBEDDING_TIMEOUT_SECONDS=60

RAG_VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=guilin_tourism
QDRANT_TIMEOUT_SECONDS=30

RERANK_MODE=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker
RERANK_TIMEOUT_SECONDS=30

KNOWLEDGE_SOURCE_REGISTRY=data/sources/guilin_official_sources.json
KNOWLEDGE_SNAPSHOT_DIR=data/snapshots
KNOWLEDGE_HTTP_TIMEOUT_SECONDS=30
RAG_EVAL_DATASET=eval/rag_eval.jsonl
RAG_EVAL_RECALL_AT_5_MIN=0.80
RAG_EVAL_MRR_MIN=0.70
RAG_EVAL_GROUNDING_ACCURACY_MIN=0.80
RAG_EVAL_CITATION_HIT_RATE_MIN=0.80

# P2 LangGraph + Tool Calling
AGENT_ENABLED=true
# Keep true for deterministic local/CI development. Set false to use live providers.
TOOL_MOCK_MODE=true
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_TEXT_LENGTH=120

# P2.5 provider reliability.
# Retries apply only to transport failures, HTTP 408/425/429 and 5xx.
TOOL_RETRY_ATTEMPTS=2
TOOL_RETRY_BASE_DELAY_SECONDS=0.20
TOOL_RETRY_MAX_DELAY_SECONDS=2.0
TOOL_CIRCUIT_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RECOVERY_SECONDS=30
TOOL_HTTP_USER_AGENT=guilin-tourism-ai/0.2.5

WEATHER_PROVIDER=open_meteo
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

SCENIC_PROVIDER=amap
ROUTE_PROVIDER=amap
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_REGION=桂林
AMAP_CITYCODE_DEFAULT=0773

# P2.5 deterministic routing evaluation.
AGENT_EVAL_DATASET=eval/intent_router_eval.jsonl
AGENT_EVAL_INTENT_ACCURACY_MIN=0.90
AGENT_EVAL_TOOL_SELECTION_ACCURACY_MIN=0.90
